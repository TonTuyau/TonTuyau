root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true

# "Column reading" (M2 review): wrapped lists and call chains put one item per line; lines stay under 120.
# Conventions on top of these (checked in review, no analyzer can force them):
#   - a LINQ chain of 2+ calls is always one call per line;
#   - a one-line argument list with 2+ arguments wraps one per line when an argument is itself a call or
#     constructor with 2+ arguments (short calls like Assert.Equal(a, b) stay on one line).
roslynator_max_line_length = 120

# "Left typing" (M3 review): the type is written on the left, never `var`; a `new` on the right is target-typed.
#   List<Video> items = new();   not   var items = new List<Video>();
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0090.severity = warning
dotnet_diagnostic.RCS0053.severity = warning
dotnet_diagnostic.RCS0054.severity = warning
dotnet_diagnostic.RCS0056.severity = warning

# EF Core's migrations, as `dotnet ef migrations add` writes them: generated code, not held to the rules above.
[**/Migrations/*.cs]
generated_code = true

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
