# TonTuyau settings. Copy to .env next to docker-compose.yml and fill in: `cp .env.example .env && chmod 600 .env`.
# .env is git-ignored: never commit real values. Every line below is read by docker/docker-compose.yml;
# an empty or missing optional value means the default written in its comment.

# --- Required ---------------------------------------------------------------------------------------------------

# TubeArchivist. TonTuyau only ever reads from it (GET/HEAD); the token is TubeArchivist → Settings → API token.
TONTUYAU_TA_URL=http://tubearchivist.lan:8000
TONTUYAU_TA_TOKEN=

# The password of TonTuyau's own Elasticsearch (user `elastic`), set on its first start. Any long random string:
#   openssl rand -base64 24
TONTUYAU_ES_PASSWORD=

# The password of TonTuyau's own PostgreSQL (the accounts), set on its first start. Another long random string.
TONTUYAU_DB_PASSWORD=

# The admin account, created at the first start (when there's no account yet): its name (default admin) and password.
# Only read then: changing them later changes nothing. Never stored as such (an Argon2id hash).
TONTUYAU_ADMIN_USER=admin
TONTUYAU_ADMIN_PASSWORD=

# --- The stack --------------------------------------------------------------------------------------------------

# Image version: `latest` (default), or a pinned one such as 1.0.0 (or 1.0: the latest 1.0.x).
TONTUYAU_VERSION=latest
# The port the web app listens on, on the VM (default 80). The only port the stack publishes.
TONTUYAU_HTTP_PORT=80
# The folder of videos on the VM (TubeArchivist's `youtube` folder: <channel id>/<video id>.<ext>), mounted read-only.
# A missing folder stops `docker compose up`; an empty one never makes the sync mark files missing.
TONTUYAU_MEDIA_PATH=/mnt/youtube

# Elasticsearch's heap (default 4g): it uses this much memory plus some for itself; the rest of the VM's RAM serves
# as its file cache. The stack sets no CPU or memory limits: give the VM what you want TonTuyau to use.
# TONTUYAU_ES_HEAP=4g

# --- Sync -------------------------------------------------------------------------------------------------------

# Schedule (5-field cron) in TONTUYAU_TZ. Defaults: incremental hourly 07:00–23:00, full on Saturday 01:00.
TONTUYAU_SYNC_INCREMENTAL_CRON=0 7-23 * * *
TONTUYAU_SYNC_FULL_CRON=0 1 * * 6
# The schedule's time zone, also the containers' clock for the logs (default Europe/Paris).
TONTUYAU_TZ=Europe/Paris
# false = the backend never syncs by itself (nor rebuilds the index after an upgrade): only `tontuyau sync …` does.
TONTUYAU_SYNC_SCHEDULER_ENABLED=true
# A full run deleting more than this many videos/channels deletes nothing until `tontuyau sync apply-deletions` (100).
TONTUYAU_SYNC_MAX_DELETIONS=100
# An incremental run re-reads this many hours before the last one it saw (24).
TONTUYAU_SYNC_INCREMENTAL_MARGIN_HOURS=24
# Format guard: a run stops when, after MIN documents (20; 0 = from the first page), more than PERCENT (50; 100 = off)
# of what it read is rejected as malformed: TubeArchivist's format may have changed.
TONTUYAU_SYNC_REJECT_GUARD_MIN_DOCUMENTS=20
TONTUYAU_SYNC_REJECT_GUARD_PERCENT=50
# Images resized at once by the sync (1–64). Default: the CPUs the backend container sees (all of the VM's by default).
# TONTUYAU_ART_RESIZE_PARALLELISM=2

# --- Rarely changed ---------------------------------------------------------------------------------------------

# Prefix of TonTuyau's index names (default tontuyau → tontuyau-videos, tontuyau-channels…).
# TubeArchivist's list window (its Elasticsearch max_result_window, 10000).
# TONTUYAU_TA_RESULT_WINDOW=10000
# PostgreSQL's database and user (default tontuyau, both), set on its first start like the password.
# TONTUYAU_DB_NAME=tontuyau
# TONTUYAU_DB_USERNAME=tontuyau
# The login cookie is only sent over HTTPS (default true). false if you browse TonTuyau over plain http:// (on the
# LAN, without an HTTPS reverse proxy): browsers drop a secure cookie there (except on localhost).
# TONTUYAU_COOKIE_SECURE=true
# Your HTTPS reverse proxy's address, as the front server sees it (several: separated by commas). Then each visitor
# gets their own 5 login attempts a minute; without it, everyone behind the proxy shares them.
# TONTUYAU_TRUSTED_PROXIES=192.168.1.1
# The address people reach TonTuyau at from the internet (no path). Discord, Messenger… then show a preview of a
# shared link: the channel, the title, the video (played in the chat in Discord). Their servers fetch the page and
# the video at this address, so it must be reachable from outside. Empty: no previews.
# TONTUYAU_PUBLIC_URL=https://tontuyau.example.net

# --- Development only (running the backend outside Docker) --------------------------------------------------------
# Inside the stack these are fixed: Elasticsearch at http://tontuyau-es:9200, PostgreSQL at tontuyau-db, media
# /youtube, art /data/art, sync logs /data/logs/sync. With `dotnet run`, point them at your machine:
# TONTUYAU_ES_URL=http://localhost:9200
# TONTUYAU_DB_HOST=localhost
# TONTUYAU_ES_USERNAME=elastic
# TONTUYAU_MEDIA_ROOT=/path/to/youtube
# TONTUYAU_ART_ROOT=/path/to/art
# TONTUYAU_SYNC_LOG_ROOT=/path/to/logs
