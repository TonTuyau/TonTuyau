<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- TonTuyau's version (QA13-4): X.Y.Z, or a pre-release X.Y.Z-alpha.N / -beta.N / -rc.N (a release branch tried
         on the VM). frontend/package.json carries the same one (scripts/check-version.sh). No "+<commit>" suffix: the
         images carry the commit in their labels. -->
    <Version>1.5.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Formatting rules (see .editorconfig): "column reading" of lists and call chains. -->
    <PackageReference Include="Roslynator.Formatting.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
