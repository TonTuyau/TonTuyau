{
  "filter": {
    "tontuyau_french_elision": {
      "type": "elision",
      "articles_case": true,
      "articles": ["l", "m", "t", "qu", "n", "s", "j", "d", "c", "jusqu", "quoiqu", "lorsqu", "puisqu"]
    },
    "tontuyau_french_stop": { "type": "stop", "stopwords": "_french_" },
    "tontuyau_french_stemmer": { "type": "stemmer", "language": "light_french" },
    "tontuyau_english_stop": { "type": "stop", "stopwords": "_english_" },
    "tontuyau_english_stemmer": { "type": "stemmer", "language": "english" },
    "tontuyau_edge_ngram": { "type": "edge_ngram", "min_gram": 1, "max_gram": 20 }
  },
  "analyzer": {
    "tontuyau_french": {
      "tokenizer": "standard",
      "filter": ["tontuyau_french_elision", "lowercase", "tontuyau_french_stop", "tontuyau_french_stemmer", "asciifolding"]
    },
    "tontuyau_english": {
      "tokenizer": "standard",
      "filter": ["lowercase", "tontuyau_english_stop", "tontuyau_english_stemmer", "asciifolding"]
    },
    "tontuyau_folded": {
      "tokenizer": "standard",
      "filter": ["lowercase", "asciifolding"]
    },
    "tontuyau_autocomplete": {
      "tokenizer": "standard",
      "filter": ["lowercase", "asciifolding", "tontuyau_edge_ngram"]
    }
  },
  "normalizer": {
    "tontuyau_sort": { "type": "custom", "filter": ["lowercase", "asciifolding"] }
  }
}
