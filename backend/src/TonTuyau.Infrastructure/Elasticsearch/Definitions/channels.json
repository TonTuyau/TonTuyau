{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": "@analysis"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": { "type": "keyword" },
      "name": {
        "type": "text",
        "analyzer": "tontuyau_french",
        "fields": {
          "en": { "type": "text", "analyzer": "tontuyau_english" },
          "autocomplete": { "type": "text", "analyzer": "tontuyau_autocomplete", "search_analyzer": "tontuyau_folded" },
          "sort": { "type": "keyword", "normalizer": "tontuyau_sort" }
        }
      },
      "description": {
        "type": "text",
        "analyzer": "tontuyau_french",
        "fields": {
          "en": { "type": "text", "analyzer": "tontuyau_english" },
          "prefix": {
            "type": "text",
            "analyzer": "tontuyau_folded",
            "index_options": "docs",
            "norms": false,
            "index_prefixes": { "min_chars": 1, "max_chars": 5 }
          }
        }
      },
      "subscribers": { "type": "long" },
      "tags": {
        "type": "text",
        "analyzer": "tontuyau_folded",
        "index_prefixes": { "min_chars": 1, "max_chars": 5 },
        "fields": { "keyword": { "type": "keyword" } }
      },
      "thumb_path": { "type": "keyword", "index": false, "doc_values": false },
      "banner_path": { "type": "keyword", "index": false, "doc_values": false },
      "thumb_art": { "type": "object", "enabled": false },
      "banner_art": { "type": "object", "enabled": false },
      "tvart_path": { "type": "keyword", "index": false, "doc_values": false },
      "youtube_state": { "type": "keyword" },
      "youtube_checked_at": { "type": "date" },
      "youtube_reason": { "type": "keyword", "index": false, "doc_values": false },
      "youtube_refreshed_at": { "type": "date" },
      "content_hash": { "type": "keyword", "index": false, "doc_values": false }
    }
  }
}
