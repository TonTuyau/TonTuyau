{
  "openapi": "3.1.1",
  "info": {
    "title": "TonTuyau API",
    "description": "Read-only REST API of TonTuyau (docs/API_CONTRACT.md). Lists are cursor-paged; errors are RFC 9457 ProblemDetails.",
    "version": "v1"
  },
  "paths": {
    "/api/home": {
      "get": {
        "tags": ["Home"],
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "description": "Videos per section, 1–100 (default 24).",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/videos": {
      "get": {
        "tags": ["Videos"],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "video | short | stream (default: all types).",
            "schema": {
              "enum": ["video", "short", "stream"],
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "latest (default) | popular | oldest.",
            "schema": {
              "enum": ["latest", "popular", "oldest"],
              "type": "string"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "description": "A video id left out of the items and the total (the short being watched).",
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{11}$",
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "nextCursor of the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "1–100 (default 24).",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfVideoCard"
                }
              }
            }
          }
        }
      }
    },
