    "/api/search": {
      "get": {
        "tags": ["Search"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "What to look for, 1–200 characters.",
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "all (default) | videos | channels.",
            "schema": {
              "enum": ["all", "videos", "channels"],
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Videos only: video | short | stream.",
            "schema": {
              "enum": ["video", "short", "stream"],
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Videos only: a channel id.",
            "schema": {
              "pattern": "^UC[A-Za-z0-9_-]{22}$",
              "type": "string"
            }
          },
          {
            "name": "published",
            "in": "query",
            "description": "Videos only: published in the last today (24 h) | week | month (30 days) | year.",
            "schema": {
              "enum": ["today", "week", "month", "year"],
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "description": "Videos only: short (< 4 min) | medium (4–20) | long (> 20).",
            "schema": {
              "enum": ["short", "medium", "long"],
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "relevance (default) | latest | popular.",
            "schema": {
              "enum": ["relevance", "latest", "popular"],
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "nextCursor of the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "1–100 (default 24).",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SearchAllResponse"
                    },
                    {
                      "$ref": "#/components/schemas/PageOfVideoCard"
                    },
                    {
                      "$ref": "#/components/schemas/PageOfChannelCard"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/search/suggest": {
      "get": {
        "tags": ["Search"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "What was typed so far, 1–100 characters.",
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "1–20 (default 8).",
            "schema": {
              "maximum": 20,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestResponse"
                }
              }
            }
          }
        }
      }
    }
  },
